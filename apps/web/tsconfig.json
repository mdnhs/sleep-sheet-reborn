{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@repo/database": ["../../packages/database/src/index.ts"],
      "@repo/types": ["../../packages/types/src/index.ts"],
      "@repo/shared": ["../../packages/shared/src/index.ts"],
      "@repo/worker": ["../../apps/worker/src/index.ts"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
