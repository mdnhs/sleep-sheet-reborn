{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sleep-sheet-reborn-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sleep-sheet-reborn",
      "database_id": "8576bc91-1a4c-402c-a198-056eac70b959",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sleep-sheet-reborn-marketplace",
      "preview_bucket_name": "sleep-sheet-reborn-marketplace"
    }
  ]
}
